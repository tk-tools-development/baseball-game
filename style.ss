body {
  text-align: center;
  background: skyblue;
  font-family: Arial;
}

#game {
  width: 600px;
  height: 300px;
  margin: auto;
  background: lightgreen;
  position: relative;
  overflow: hidden;
}

#ball {
  width: 30px;
  height: 30px;
  background: white;
  border-radius: 50%;
  position: absolute;
  top: 100px;
  left: 0;
}